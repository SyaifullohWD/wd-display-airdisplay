<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by design/art/build_icons_from_master.py. The artwork is placed at
     the 72dp viewport inside the 108dp canvas and the surrounding ring is a
     clamped extension of the tile's own edge pixels, so every launcher mask
     crops only the ring and never the mark.
     No <monochrome> layer on purpose: the gradient tile and glass mark are the
     identity, so this app opts out of Android 13 themed-icon tinting and always
     shows the original artwork. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
